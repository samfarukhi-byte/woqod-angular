  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script for all requests",
          "// Ensure API credentials are set in environment variables",
          "",
          "if (!pm.variables.get('apiKey') || pm.variables.get('apiKey') === 'your_api_key_here') {",
          "    console.warn('⚠️ Please set your API Key in the collection variables');",
          "}",
          "",
          "if (!pm.variables.get('apiSecret') || pm.variables.get('apiSecret') === 'your_secret_key_here') {",
          "    console.warn('⚠️ Please set your API Secret in the collection variables');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test script for all requests",
          "",
          "// Check response time",
          "pm.test('Response time is less than 2000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",
          "",
          "// Check response format",
          "pm.test('Response has success field', function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('success');",
          "});",
          "",
          "// Check for successful response",
          "if (pm.response.code === 200) {",
          "    pm.test('Successful response has data field', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData.success).to.be.true;",
          "        pm.expect(jsonData).to.have.property('data');",
          "    });",
          "}",
          "",
          "// Check for error response",
          "if (pm.response.code >= 400) {",
          "    pm.test('Error response has errorCode', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData.success).to.be.false;",
          "        pm.expect(jsonData).to.have.property('errorCode');",
          "    });",
          "}"
        ]
      }
    }
  ]
}
