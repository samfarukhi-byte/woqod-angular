{
  "info": {
    "name": "WOQOD Total Control - Open API",
    "description": "Complete API collection for WOQOD Total Control Customer Self-Portal Open API. Access invoices, vehicles, consumption data, and customer profile programmatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "woqod-open-api-v1",
    "version": "1.0.0"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4200/api/open/v1",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "your_api_key_here",
      "type": "string"
    },
    {
      "key": "apiSecret",
      "value": "your_secret_key_here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Customer",
      "item": [
        {
          "name": "Get Customer Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "X-API-SECRET",
                "value": "{{apiSecret}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/profile",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "profile"]
            },
            "description": "Retrieve authenticated customer profile details including contact information, credit limit, and account status."
          },
          "response": []
        }
      ],
      "description": "Customer profile endpoints"
    },
    {
      "name": "Invoices",
