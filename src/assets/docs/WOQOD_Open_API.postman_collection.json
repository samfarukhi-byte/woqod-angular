            "url": {
              "raw": "{{baseUrl}}/invoices?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["invoices"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "pageSize",
                  "value": "20",
                  "description": "Items per page (max: 100)"
                },
                {
                  "key": "fromDate",
                  "value": "2024-01-01",
                  "disabled": true,
                  "description": "Filter from date (YYYY-MM-DD)"
                },
                {
                  "key": "toDate",
                  "value": "2024-12-31",
                  "disabled": true,
                  "description": "Filter to date (YYYY-MM-DD)"
                },
                {
                  "key": "status",
                  "value": "Paid",
                  "disabled": true,
                  "description": "Filter by status: Paid, Pending, Overdue, Cancelled, Partial"
                }
              ]
            },
            "description": "Retrieve paginated list of customer invoices with optional date range and status filters."
          },
          "response": []
        },
        {
          "name": "Get Invoice by Number",
          "request": {
            "method": "GET",
